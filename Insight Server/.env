# Environment Configuration for Vision AI Server

# Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# Model Configuration
MAIN_MODEL_PATH=/app/models/main_model.pt
ARCHITECTURAL_MODEL_PATH=/app/models/architectural_model.pt
MODEL_SWITCH_INTERVAL=30

# Vision Configuration
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
DETECTION_INTERVAL=2.0
NEAR_THRESHOLD=8.0
ARCH_NEAR_THRESHOLD=15.0

# Performance Configuration
WORKERS=4
WORKER_TIMEOUT=60
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s